---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { me } from '../lib/site';

interface Props { title?: string; description?: string; nav?: boolean }
const {
  title = `${me.name} — ${me.role}`,
  description = `${me.name}. ${me.tagline} ${me.degree} at ${me.school}.`,
  nav = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {nav && <Nav />}
    <main>
      <slot />
    </main>
    <script>
      import '../lib/reveal';
    </script>
  </body>
</html>
