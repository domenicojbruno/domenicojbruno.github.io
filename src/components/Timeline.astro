---
import Section from './Section.astro';

const entries = [
  {
    when: 'Aug 2026 — now',
    what: 'Undergraduate Research Assistant',
    where: 'Integrated Circuits & Systems Lab, WPI',
    note: 'Wearable and physiological sensing. Currently building closed-loop temperature control for a CO₂ sensor, to hold its operating point stable enough to trust the measurement.',
    kind: 'Research',
  },
  {
    when: 'Aug 2026 — now',
    what: 'Teaching Assistant, ECE 2201 Microelectronics I',
    where: 'WPI',
    note: 'Office hours and labs for the course where everyone meets a MOSFET for the first time.',
    kind: 'Teaching',
  },
  {
    when: 'Aug 2026 — now',
    what: 'North America STEM Aspire Program',
    where: 'Dell Technologies, Hopkinton MA',
    note: 'One of 38 selected nationally; paired with a Dell engineer for workshops, facility tours and career prep.',
    kind: 'Program',
  },
  {
    when: 'May — Aug 2026',
    what: 'Electrical Engineering Intern, Group 92',
    where: 'MIT Lincoln Laboratory, Westford MA',
    note: 'Supported the RF transmitter team at the Lincoln Space Surveillance Complex, designing and building hardware to replace obsolete equipment on the Millstone Hill Radar — a system that has been continuously evolving since 1957. Schematics, PCBs and mechanical chassis; characterisation on spectrum analysers, oscilloscopes and signal generators; component selection and BOMs.',
    kind: 'Industry',
  },
  {
    when: 'Sept 2025 — now',
    what: 'Founding Member, IEEE Solid-State Circuits Society',
    where: 'WPI Chapter',
    note: 'Co-founded the chapter and ran technical events with working IC designers, because nothing like it existed on campus. The chapter was featured in IEEE Solid-State Circuits Magazine in its first year.',
    kind: 'Community',
  },
  {
    when: 'Aug 2024 — now',
    what: 'Resident Advisor & Union Bargaining Committee',
    where: 'Worcester Polytechnic Institute',
    note: 'Supporting 200+ residents into a third year: community events, resident concerns, conflict mediation. Also serve on the contract bargaining committee for the residential staff union.',
    kind: 'Leadership',
  },
  {
    when: 'Summers 2022 & 2023',
    what: 'Trumpet Section Leader',
    where: 'Spartans Drum & Bugle Corps, Nashua NH',
    note: 'Led the trumpet section through two national competitive seasons.',
    kind: 'Music',
  },
];
---

<Section id="transient" title="How it settled.">
  <p class="lede reveal">
    Research, industry, teaching and the things that were never on a syllabus.
  </p>

  <ol class="tl">
    {entries.map((e) => (
      <li class="reveal">
        <span class="tl__dot" aria-hidden="true"></span>
        <p class="tl__when mono">{e.when}</p>
        <div class="tl__body">
          <h3>{e.what}</h3>
          <p class="tl__where mono">{e.where}</p>
          <p class="tl__note">{e.note}</p>
        </div>
        <span class="tl__kind mono">{e.kind}</span>
      </li>
    ))}
  </ol>
</Section>

<style>
  .lede { margin-bottom: 3rem; }

  .tl { list-style: none; margin: 0; padding: 0; position: relative; }
  /* the spine */
  .tl::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    bottom: 2rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent), var(--line) 30%, var(--line));
  }

  .tl li {
    position: relative;
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) auto;
    gap: 0.35rem 2rem;
    padding: 0 0 2.5rem 2rem;
    align-items: start;
  }

  .tl__dot {
    position: absolute;
    left: -3.5px;
    top: 0.5rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--accent);
  }
  .tl li:first-child .tl__dot { background: var(--accent); box-shadow: 0 0 0 4px var(--glow); }

  .tl__when {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding-top: 0.2rem;
  }
  .tl__body h3 { font-size: 1.05rem; }
  .tl__where { font-size: 0.7rem; color: var(--accent); letter-spacing: 0.08em; margin-top: 0.25rem; }
  .tl__note { color: var(--fg-2); font-size: 0.92rem; margin-top: 0.6rem; max-width: 58ch; }

  .tl__kind {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .tl li {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'when kind' 'body body';
      gap: 0.6rem 1rem;
    }
    .tl__when { grid-area: when; }
    .tl__kind { grid-area: kind; }
    .tl__body { grid-area: body; }
  }
</style>
