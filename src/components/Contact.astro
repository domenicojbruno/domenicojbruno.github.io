---
import { me } from '../lib/site';

const links = [
  ['Email', me.email, `mailto:${me.email}`],
  ['Phone', me.phone, `tel:${me.phone.replace(/[^+\d]/g, '')}`],
  ['GitHub', me.github && '@' + me.github.split('/').pop(), me.github],
  ['LinkedIn', me.linkedin && 'Domenico Bruno', me.linkedin],
].filter((l): l is [string, string, string] => Boolean(l[1] && l[2]));
---

<section id="noise" data-theme="noise" class="section noise">
  <canvas class="noise__bg" data-noise aria-hidden="true"></canvas>

  <div class="section__inner noise__inner">
    <p class="eyebrow reveal">08 — Noise Floor</p>
    <h2 class="reveal">
      Everything useful<br />lives above it.
    </h2>
    <p class="lede reveal">
      Looking for an analog or mixed-signal internship where I can take a block
      from schematic through layout and silicon. If that is the kind of work on
      your bench, get in touch.
    </p>

    <ul class="noise__links reveal">
      {links.map(([k, v, href]) => (
        <li>
          <span class="noise__k">{k}</span>
          <a href={href}>{v}</a>
        </li>
      ))}
    </ul>

    <div class="noise__cta reveal">
      <a class="btn btn--primary" href={`mailto:${me.email}`}>{me.email}</a>
      <a class="btn" href={me.resume} download>Download CV (PDF)</a>
    </div>

    <footer class="noise__foot">
      <span>© {new Date().getFullYear()} {me.name}</span>
      <span>{me.location}</span>
      <span>Built with Astro · no tracking</span>
    </footer>
  </div>
</section>

<script>
  import { mountCanvas, cssVar } from '../lib/canvas';

  const el = document.querySelector<HTMLCanvasElement>('[data-noise]');
  if (el) {
    // A noise floor with a signal buried in it — the trace resolves out of the
    // grass and sinks back, on a slow cycle.
    mountCanvas(el, (ctx, w, h, t) => {
      const accent = cssVar(el, '--accent');
      const mid = h / 2;
      const snr = 0.5 + 0.5 * Math.sin(t * 0.28);

      ctx.strokeStyle = accent;
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = 0; x <= w; x += 2) {
        const p = x / w;
        // fract() hash — taking the fractional part keeps this centred on zero;
        // a plain `% 1` on a signed value biases the whole trace downward.
        const r = Math.sin(x * 12.9898 + Math.floor(t * 12)) * 43758.5453;
        const grass = (r - Math.floor(r)) * 2 - 1;
        const y = mid + grass * h * 0.06 * (1.2 - snr * 0.6)
                      + Math.sin(p * 9 - t) * h * 0.11 * snr;
        x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
    });
  }
</script>

<style>
  .noise { position: relative; overflow: hidden; padding-bottom: 3rem; }
  .noise__bg {
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    width: 100%;
    opacity: 0.32;
    mask-image: linear-gradient(to bottom, transparent, #000 60%);
  }
  .noise__inner { position: relative; }

  .noise .lede { margin-top: 1.5rem; }

  .noise__links {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem 2rem;
    max-width: 44rem;
  }
  .noise__links li { border-top: 1px solid var(--line); padding-top: 0.8rem; }
  .noise__k {
    display: block;
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 0.3rem;
  }
  .noise__links a { color: var(--fg); border-bottom: 1px solid transparent; transition: border-color 0.2s, color 0.2s; }
  .noise__links a:hover { color: var(--accent); border-color: var(--accent); }

  .noise__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }

  .noise__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin-top: 5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
</style>
