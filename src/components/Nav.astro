---
import { sections, me } from '../lib/site';
---

<nav class="rail" data-rail data-theme="bias" aria-label="Sections">
  <a class="rail__mark" href="#bias" aria-label="Top">
    <span>DB</span><i class="rail__led" aria-hidden="true"></i>
  </a>

  <ol class="rail__list">
    {sections.map((s) => (
      <li>
        <a href={`#${s.id}`} data-for={s.id}>
          <span class="rail__n">{s.n}</span>
          <span class="rail__label">{s.label}</span>
        </a>
      </li>
    ))}
  </ol>

  <a class="rail__cv" href={me.resume} download>CV</a>
</nav>

<style>
  .rail {
    position: fixed;
    z-index: 50;
    font-family: var(--mono);
    /* the rail carries the current section's accent, set from reveal.ts */
    transition: color 0.4s;
  }

  .rail__mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
  }
  .rail__led {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2.6s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: 0.35; } }

  .rail__list { list-style: none; padding: 0; margin: 0; }
  .rail__list a {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    font-size: 0.7rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding: 0.34rem 0;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .rail__list a:hover { color: var(--fg-2); }
  .rail__list a.is-active { color: var(--accent); }
  .rail__n { font-size: 0.62rem; opacity: 0.6; }

  .rail__cv {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--fg-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.4rem 0.75rem;
    transition: border-color 0.2s, color 0.2s;
  }
  .rail__cv:hover { color: var(--accent); border-color: var(--accent); }

  /* Desktop: a vertical rail down the left edge, like a channel list. */
  @media (min-width: 1100px) {
    .rail {
      inset: 0 auto 0 0;
      width: var(--rail);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      padding: 2.25rem 0 2.25rem var(--pad);
      border-right: 1px solid var(--line);
      background: color-mix(in oklab, var(--bg) 82%, transparent);
      backdrop-filter: blur(10px);
    }
  }

  /* Below that the labels don't fit, so it collapses to a numeric top bar. */
  @media (max-width: 1099px) {
    .rail {
      inset: 0 0 auto 0;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.7rem var(--pad);
      border-bottom: 1px solid var(--line);
      background: color-mix(in oklab, var(--bg) 88%, transparent);
      backdrop-filter: blur(10px);
    }
    .rail__list {
      display: flex;
      /* tight enough that all eight numbers fit at 375px without scrolling */
      gap: 0.25rem;
      overflow-x: auto;
      flex: 1;
      scrollbar-width: none;
    }
    .rail__list::-webkit-scrollbar { display: none; }
    .rail__label { display: none; }
    .rail__n { font-size: 0.7rem; opacity: 1; }
    .rail__list a { padding: 0.3rem 0.25rem; }
  }
</style>
