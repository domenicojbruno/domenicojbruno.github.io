---
// The interactive half of the playground: the same OTA-C blocks from
// clEAR-ExG, evaluated live. Closed-form response, hand-drawn canvas, no
// charting library and no dependency.
---

<div class="sim" data-sim>
  <div class="sim__tabs" role="tablist" aria-label="Filter">
    <button role="tab" data-tab="lp" aria-selected="true" id="tab-lp" aria-controls="pane-lp">
      OTA-C Low-Pass
    </button>
    <button role="tab" data-tab="notch" aria-selected="false" id="tab-notch" aria-controls="pane-notch">
      60 Hz Notch
    </button>
  </div>

  <!-- ------------------------------------------------------------ low-pass -->
  <div class="sim__pane" id="pane-lp" role="tabpanel" aria-labelledby="tab-lp" data-pane="lp">
    <div class="sim__plot">
      <canvas data-bode aria-label="Bode magnitude plot of the low-pass filter"></canvas>
      <p class="sim__hint mono">Dashed line: the 101.3 Hz corner measured in clEAR-ExG.</p>
    </div>

    <div class="sim__side">
      <div class="sim__readout">
        <div><span class="stat__k">Corner f₀</span><b data-out="f0">—</b></div>
        <div><span class="stat__k">g<sub>m</sub> (raw)</span><b data-out="gm">—</b></div>
        <div><span class="stat__k">Power</span><b data-out="pw">—</b></div>
      </div>

      <label class="ctl">
        <span>Bias current <b data-val="ib"></b></span>
        <input type="range" data-in="ib" min="0" max="100" value="51" />
        <i class="mono">1 nA — 100 nA, log</i>
      </label>

      <label class="ctl">
        <span>Capacitance <b data-val="c"></b></span>
        <input type="range" data-in="c" min="1" max="50" step="0.5" value="10" />
        <i class="mono">on-chip, pF</i>
      </label>

      <label class="ctl">
        <span>g<sub>m</sub> division M <b data-val="m"></b></span>
        <input type="range" data-in="m" min="1" max="100" step="1" value="42" />
        <i class="mono">current division ratio</i>
      </label>

      <label class="ctl">
        <span>Q <b data-val="q"></b></span>
        <input type="range" data-in="q" min="0.4" max="3" step="0.05" value="0.707" />
        <i class="mono">0.707 = maximally flat</i>
      </label>

      <p class="sim__why">
        In subthreshold, <code>g<sub>m</sub> = I<sub>D</sub>/nV<sub>T</sub></code> — linear in
        current. Drop the bias and the corner drops with it, which is how a
        100 Hz filter fits on a chip at all.
      </p>
    </div>
  </div>

  <!-- --------------------------------------------------------------- notch -->
  <div class="sim__pane" id="pane-notch" role="tabpanel" aria-labelledby="tab-notch" data-pane="notch" hidden>
    <div class="sim__plot">
      <canvas data-notch aria-label="Magnitude response of the notch filter"></canvas>
      <canvas data-trace class="sim__trace" aria-label="Simulated EEG trace before and after the notch"></canvas>
      <p class="sim__hint mono">
        <span class="k k--raw"></span> raw + mains hum
        <span class="k k--out"></span> after the notch
      </p>
    </div>

    <div class="sim__side">
      <div class="sim__readout">
        <div><span class="stat__k">Notch f₀</span><b data-out="nf">—</b></div>
        <div><span class="stat__k">Depth @ 60 Hz</span><b data-out="nd">—</b></div>
        <div><span class="stat__k">Hum left</span><b data-out="nr">—</b></div>
      </div>

      <label class="ctl">
        <span>Notch frequency <b data-val="nf"></b></span>
        <input type="range" data-in="nf" min="30" max="120" step="0.5" value="42" />
        <i class="mono">drag onto the hum</i>
      </label>

      <label class="ctl">
        <span>Q <b data-val="nq"></b></span>
        <input type="range" data-in="nq" min="1" max="30" step="0.5" value="8" />
        <i class="mono">how narrow the null is</i>
      </label>

      <label class="ctl">
        <span>Hum amplitude <b data-val="nh"></b></span>
        <input type="range" data-in="nh" min="0" max="6" step="0.1" value="3" />
        <i class="mono">× the EEG signal</i>
      </label>

      <p class="sim__why">
        Mains hum arrives orders of magnitude larger than the brain activity
        underneath it. Park the null on 60 Hz and the trace resolves — miss by a
        few hertz and it doesn't.
      </p>
    </div>
  </div>
</div>

<script>
  import { mountCanvas, cssVar } from '../lib/canvas';
  import {
    gmFromBias, cornerHz, biasPower, lowpassDb, notchDb,
    notchBiquad, runBiquad, eegTrace,
  } from '../lib/filter-math';

  const root = document.querySelector<HTMLElement>('[data-sim]');
  if (root) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const inputs = Object.fromEntries(
      [...root.querySelectorAll<HTMLInputElement>('[data-in]')].map((i) => [i.dataset.in, i])
    ) as Record<string, HTMLInputElement>;
    const out = (k: string, v: string) => {
      const el = root.querySelector(`[data-out="${k}"]`);
      if (el) el.textContent = v;
    };
    const val = (k: string, v: string) => {
      const el = root.querySelector(`[data-val="${k}"]`);
      if (el) el.textContent = v;
    };

    // The bias slider is logarithmic: 0..100 maps onto 1 nA..100 nA.
    const bias = () => 1e-9 * 10 ** (+inputs.ib.value / 50);
    const eng = (x: number, unit: string) => {
      const p = [[1e-9, 'n'], [1e-6, 'µ'], [1e-3, 'm'], [1, '']] as const;
      const [s, pre] = p.find(([s]) => x < s * 1000) ?? p[3];
      return `${(x / s).toPrecision(3)} ${pre}${unit}`;
    };

    // ---------------------------------------------------------- plot frame
    const F_MIN = 1, F_MAX = 10_000, DB_TOP = 12, DB_BOT = -72;
    const fx = (f: number, w: number) =>
      (Math.log10(f / F_MIN) / Math.log10(F_MAX / F_MIN)) * w;
    const dy = (db: number, h: number) =>
      ((DB_TOP - db) / (DB_TOP - DB_BOT)) * h;

    function frame(ctx: CanvasRenderingContext2D, w: number, h: number, el: Element) {
      const line = cssVar(el, '--line');
      ctx.strokeStyle = line;
      ctx.fillStyle = cssVar(el, '--fg-3');
      ctx.lineWidth = 1;
      ctx.font = '10px ui-monospace, monospace';

      for (let d = 0; d < 4; d++) {
        for (let m = 1; m < 10; m++) {
          const f = 10 ** d * m;
          if (f > F_MAX) break;
          const x = Math.round(fx(f, w)) + 0.5;
          ctx.globalAlpha = m === 1 ? 0.9 : 0.3;
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
          if (m === 1) {
            ctx.globalAlpha = 1;
            ctx.fillText(f >= 1000 ? `${f / 1000}k` : `${f}`, x + 3, h - 4);
          }
        }
      }
      for (let db = DB_TOP; db >= DB_BOT; db -= 12) {
        const y = Math.round(dy(db, h)) + 0.5;
        ctx.globalAlpha = db === 0 ? 0.9 : 0.3;
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.fillText(`${db}`, 3, y - 3);
      }
      ctx.globalAlpha = 1;
    }

    function curve(
      ctx: CanvasRenderingContext2D, w: number, h: number,
      color: string, at: (f: number) => number
    ) {
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.shadowColor = color;
      ctx.shadowBlur = 8;
      ctx.beginPath();
      for (let x = 0; x <= w; x++) {
        const f = F_MIN * (F_MAX / F_MIN) ** (x / w);
        const y = Math.max(-2, Math.min(h + 2, dy(at(f), h)));
        x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
    }

    // -------------------------------------------------------------- low-pass
    const bode = $<HTMLCanvasElement>('[data-bode]');
    const lp = mountCanvas(bode, (ctx, w, h) => {
      const gm = gmFromBias(bias());
      const c = +inputs.c.value * 1e-12;
      const m = +inputs.m.value;
      const q = +inputs.q.value;
      const f0 = cornerHz(gm, c, m);

      frame(ctx, w, h, bode);

      // reference marker: the corner the real chip measured
      ctx.strokeStyle = cssVar(bode, '--fg-3');
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(fx(101.3, w), 0);
      ctx.lineTo(fx(101.3, w), h);
      ctx.stroke();
      ctx.setLineDash([]);

      curve(ctx, w, h, cssVar(bode, '--accent'), (f) => lowpassDb(f, f0, q));

      // and where the current settings actually land
      const x = fx(f0, w), y = dy(lowpassDb(f0, f0, q), h);
      ctx.fillStyle = cssVar(bode, '--accent');
      ctx.beginPath(); ctx.arc(x, y, 4, 0, 7); ctx.fill();
    }, false);

    function drawLp() {
      const i = bias();
      const gm = gmFromBias(i);
      const f0 = cornerHz(gm, +inputs.c.value * 1e-12, +inputs.m.value);
      val('ib', eng(i, 'A'));
      val('c', `${(+inputs.c.value).toFixed(1)} pF`);
      val('m', `${inputs.m.value}×`);
      val('q', (+inputs.q.value).toFixed(2));
      out('f0', f0 < 1000 ? `${f0.toFixed(1)} Hz` : `${(f0 / 1000).toFixed(2)} kHz`);
      out('gm', eng(gm, 'S'));
      out('pw', eng(biasPower(i), 'W'));
      lp.repaint();
    }

    // ----------------------------------------------------------------- notch
    const FS = 1000, NSAMP = 1200;
    const nplot = $<HTMLCanvasElement>('[data-notch]');
    const ntrace = $<HTMLCanvasElement>('[data-trace]');

    const np = mountCanvas(nplot, (ctx, w, h) => {
      const f0 = +inputs.nf.value, q = +inputs.nq.value;
      frame(ctx, w, h, nplot);

      ctx.strokeStyle = cssVar(nplot, '--fg-3');
      ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(fx(60, w), 0); ctx.lineTo(fx(60, w), h); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = cssVar(nplot, '--fg-3');
      ctx.font = '10px ui-monospace, monospace';
      ctx.fillText('60 Hz mains', fx(60, w) + 4, 12);

      curve(ctx, w, h, cssVar(nplot, '--accent'), (f) => notchDb(f, f0, q));
    }, false);

    // The trace scrolls, so this one does run a loop — but only while visible.
    mountCanvas(ntrace, (ctx, w, h, t) => {
      const f0 = +inputs.nf.value, q = +inputs.nq.value, hum = +inputs.nh.value;
      const dirty = eegTrace(NSAMP, FS, hum);
      const clean = runBiquad(notchBiquad(f0, q, FS), dirty);
      const off = Math.floor(t * 90) % (NSAMP / 2);
      const span = NSAMP / 2;
      const scale = h / 2 / Math.max(2, 1.6 + hum);

      const draw = (buf: Float32Array, color: string, mid: number, alpha: number) => {
        ctx.globalAlpha = alpha;
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        for (let i = 0; i < span; i++) {
          const x = (i / span) * w;
          const y = mid - buf[i + off] * scale;
          i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
      };

      draw(dirty, cssVar(ntrace, '--fg-3'), h * 0.28, 0.85);
      draw(clean, cssVar(ntrace, '--accent'), h * 0.74, 1);
    });

    function drawNotch() {
      const f0 = +inputs.nf.value, q = +inputs.nq.value, hum = +inputs.nh.value;
      val('nf', `${f0.toFixed(1)} Hz`);
      val('nq', q.toFixed(1));
      val('nh', `${hum.toFixed(1)}×`);
      out('nf', `${f0.toFixed(1)} Hz`);
      out('nd', `${notchDb(60, f0, q).toFixed(1)} dB`);
      // how much of the 60 Hz tone actually survives, in amplitude terms
      out('nr', `${(100 * 10 ** (notchDb(60, f0, q) / 20)).toFixed(1)} %`);
      np.repaint();
    }

    // ------------------------------------------------------------------ wire
    for (const i of Object.values(inputs)) {
      i.addEventListener('input', () => (drawLp(), drawNotch()));
    }

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    for (const b of tabs) {
      b.addEventListener('click', () => {
        for (const o of tabs) o.setAttribute('aria-selected', String(o === b));
        for (const p of root.querySelectorAll<HTMLElement>('[data-pane]')) {
          p.hidden = p.dataset.pane !== b.dataset.tab;
        }
        drawLp();
        drawNotch();
      });
    }

    drawLp();
    drawNotch();
  }
</script>

<style>
  .sim { border: 1px solid var(--line); border-radius: 5px; background: var(--bg-2); overflow: hidden; }

  .sim__tabs { display: flex; border-bottom: 1px solid var(--line); }
  .sim__tabs button {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding: 0.85rem 1.25rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .sim__tabs button:hover { color: var(--fg-2); }
  .sim__tabs button[aria-selected='true'] { color: var(--accent); border-color: var(--accent); background: var(--wash); }

  .sim__pane { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; }
  .sim__pane[hidden] { display: none; }
  @media (max-width: 820px) { .sim__pane { grid-template-columns: 1fr; } }

  .sim__plot { padding: 1.25rem; display: grid; gap: 0.75rem; align-content: start; }
  .sim__plot canvas {
    width: 100%;
    height: 240px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 3px;
  }
  .sim__trace { height: 150px !important; }

  .sim__hint { color: var(--fg-3); font-size: 0.64rem; letter-spacing: 0.08em; display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .k { width: 14px; height: 2px; display: inline-block; }
  .k--raw { background: var(--fg-3); }
  .k--out { background: var(--accent); margin-left: 0.8rem; }

  .sim__side {
    border-left: 1px solid var(--line);
    padding: 1.25rem;
    display: grid;
    gap: 1.15rem;
    align-content: start;
    background: var(--bg-3);
  }
  @media (max-width: 820px) { .sim__side { border-left: 0; border-top: 1px solid var(--line); } }

  .sim__readout { display: grid; gap: 0.7rem; }
  .sim__readout > div { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; border-bottom: 1px solid var(--line); padding-bottom: 0.45rem; }
  .sim__readout b { font-family: var(--mono); font-size: 0.95rem; color: var(--accent); font-weight: 500; }

  .ctl { display: grid; gap: 0.35rem; }
  .ctl > span { font-size: 0.78rem; display: flex; justify-content: space-between; gap: 0.5rem; }
  .ctl > span b { font-family: var(--mono); font-size: 0.74rem; color: var(--accent); font-weight: 500; }
  .ctl i { font-size: 0.6rem; color: var(--fg-3); font-style: normal; letter-spacing: 0.08em; }

  .ctl input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 22px;          /* generous hit area for touch */
    background: transparent;
    cursor: ew-resize;
  }
  /* 22px is a fine mouse target and a bad finger one */
  @media (pointer: coarse) {
    .ctl input[type='range'] { height: 44px; }
  }

  .ctl input::-webkit-slider-runnable-track { height: 2px; background: var(--line); border-radius: 2px; }
  .ctl input::-moz-range-track { height: 2px; background: var(--line); border-radius: 2px; }
  .ctl input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 15px; height: 15px; margin-top: -6.5px;
    border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 4px var(--glow);
  }
  .ctl input::-moz-range-thumb {
    width: 15px; height: 15px; border: 0;
    border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 4px var(--glow);
  }

  .sim__why { font-size: 0.8rem; color: var(--fg-3); border-top: 1px solid var(--line); padding-top: 0.9rem; }
  .sim__why code { font-family: var(--mono); color: var(--fg-2); font-size: 0.95em; }
</style>
