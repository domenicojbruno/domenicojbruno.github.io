---
import Section from './Section.astro';

const groups = [
  {
    k: 'Analog & Mixed-Signal',
    items: [
      'Subthreshold OTA design', 'OTA-C filters', 'CMOS amplifiers',
      'Bandgap & beta-multiplier references', 'Chopper instrumentation amps',
      'Miller compensation', 'PVT analysis', 'Noise analysis', 'PSRR / CMRR',
    ],
  },
  {
    k: 'EDA & Verification',
    items: [
      'Cadence Virtuoso', 'Schematic & layout', 'ADE L / ADE XL', 'Spectre',
      'Calibre DRC', 'Calibre LVS', 'Calibre PEX', 'LTspice',
    ],
  },
  {
    k: 'Hardware & Lab',
    items: [
      'PCB design', 'RF measurement', 'Spectrum analyser', 'Oscilloscope',
      'Signal generator', 'Multimeter', 'Bench characterisation', 'BOMs',
    ],
  },
  {
    k: 'Programming & HDL',
    items: ['Verilog', 'C / C++', 'Python', 'MATLAB', 'FPGA (Basys 3, Vivado)'],
  },
];

const courses = [
  ['ECE 524', 'Advanced Analog IC Design', 'Grad', 'clEAR-ExG front-end, five design assignments in Virtuoso'],
  ['ECE 4902', 'CMOS Fundamentals', 'Grad', 'Two-stage Miller OTA + bandgap, taken through layout and PEX'],
  ['ECE 5204', 'Analog Circuits and Intuition', 'Grad', 'Feedback amplifier analysis, LTspice verification'],
  ['ECE 3829', 'Advanced Digital Design with FPGAs', 'UG', 'VGA controller, timer FSMs, seven-segment drivers'],
  ['ECE 2029', 'Digital Circuit Design', 'UG', 'Combinational logic, FSMs, the digital lock project'],
  ['ECE 2201', 'Microelectronics I', 'UG · TA', 'Now teaching it'],
];
---

<Section id="corners" title="What I actually know how to do.">
  <p class="lede reveal">
    Listed by where it was used, not by how confident I feel about it.
  </p>

  <div class="grid">
    {groups.map((g) => (
      <div class="card reveal">
        <h3 class="stat__k">{g.k}</h3>
        <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
      </div>
    ))}
  </div>

  <h3 class="head reveal">Coursework behind it</h3>
  <div class="tbl reveal">
    <table>
      <thead>
        <tr><th>Course</th><th>Title</th><th>Level</th><th>What came out of it</th></tr>
      </thead>
      <tbody>
        {courses.map(([c, t, l, o]) => (
          <tr><td class="c">{c}</td><td>{t}</td><td class="l">{l}</td><td class="o">{o}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>

<style>
  .lede { margin-bottom: 2.5rem; }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.25rem; }
  .card h3 { margin-bottom: 0.9rem; color: var(--accent); }
  .card ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .card li {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--fg-2);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.25rem 0.5rem;
  }

  .head { margin: 4rem 0 1.5rem; color: var(--fg-2); }
  .tbl { overflow-x: auto; border: 1px solid var(--line); border-radius: 4px; }
  table { border-collapse: collapse; width: 100%; min-width: 42rem; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.7rem 1rem; border-bottom: 1px solid var(--line); }
  thead th {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
    background: var(--bg-2);
  }
  tbody tr:last-child td { border-bottom: 0; }
  .c { font-family: var(--mono); color: var(--accent); white-space: nowrap; }
  .l { font-family: var(--mono); font-size: 0.72rem; color: var(--fg-3); }
  .o { color: var(--fg-2); }
</style>
